<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    {%- if settings.favicon != blank -%}<link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">{%- endif -%}
    <title>{{ shop.name }}</title>
    {{ content_for_header }}
    {% style %}
      {{ settings.body_font | font_face: font_display: 'swap' }}
      {{ settings.heading_font | font_face: font_display: 'swap' }}
      :root {
        --color-background: {{ settings.color_background }};
        --color-foreground: {{ settings.color_text }};
        --color-foreground-soft: {{ settings.color_text | color_mix: settings.color_background, 65 }};
        --color-primary: {{ settings.color_primary }};
        --color-primary-dark: {{ settings.color_primary | color_darken: 8 }};
        --color-button-text: {{ settings.color_button_text }};
        --color-card: {{ settings.color_card_background }};
        --color-border: {{ settings.color_text | color_mix: settings.color_background, 14 }};
        --font-body-family: {{ settings.body_font.family }}, {{ settings.body_font.fallback_families }};
        --font-heading-family: {{ settings.heading_font.family }}, {{ settings.heading_font.fallback_families }};
        --button-radius: {{ settings.button_radius }}px;
        --radius: {{ settings.corner_radius }}px;
      }
    {% endstyle %}
    {{ 'theme.css' | asset_url | stylesheet_tag }}
  </head>
  <body class="template-password">
    {{ content_for_layout }}
  </body>
</html>
