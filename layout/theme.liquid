<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="theme-color" content="{{ settings.color_primary }}">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    {%- unless settings.page_width == blank -%}
      <style>:root { --page-width: {{ settings.page_width }}px; }</style>
    {%- endunless -%}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    {% render 'meta-tags' %}

    {{ content_for_header }}

    {%- liquid
      assign body_font = settings.body_font
      assign heading_font = settings.heading_font
      assign body_font_bold = body_font | font_modify: 'weight', 'bold'
    -%}

    {% style %}
      {{ body_font | font_face: font_display: 'swap' }}
      {{ body_font_bold | font_face: font_display: 'swap' }}
      {{ heading_font | font_face: font_display: 'swap' }}

      :root {
        /* ---- Colors (fully editable in Theme settings → Colors) ---- */
        --color-background: {{ settings.color_background }};
        --color-background-alt: {{ settings.color_background_alt }};
        --color-foreground: {{ settings.color_text }};
        --color-foreground-soft: {{ settings.color_text | color_mix: settings.color_background, 65 }};
        --color-primary: {{ settings.color_primary }};
        --color-primary-dark: {{ settings.color_primary | color_darken: 8 }};
        --color-secondary: {{ settings.color_secondary }};
        --color-accent: {{ settings.color_accent }};
        --color-button-text: {{ settings.color_button_text }};
        --color-border: {{ settings.color_text | color_mix: settings.color_background, 14 }};
        --color-card: {{ settings.color_card_background }};
        --color-sale: {{ settings.color_sale }};
        --color-star: {{ settings.color_star }};

        /* ---- Typography ---- */
        --font-body-family: {{ body_font.family }}, {{ body_font.fallback_families }};
        --font-body-weight: {{ body_font.weight }};
        --font-heading-family: {{ heading_font.family }}, {{ heading_font.fallback_families }};
        --font-heading-weight: {{ heading_font.weight }};
        --font-base-size: {{ settings.base_font_size }}px;
        --heading-scale: {{ settings.heading_scale | divided_by: 100.0 }};
        --heading-letter-spacing: {{ settings.heading_letter_spacing }}px;

        /* ---- Layout ---- */
        --page-width: {{ settings.page_width }}px;
        --section-spacing: {{ settings.section_spacing }}px;
        --radius: {{ settings.corner_radius }}px;
        --radius-sm: {{ settings.corner_radius | times: 0.55 | round }}px;
        --button-radius: {{ settings.button_radius }}px;
        --shadow-color: {{ settings.color_text | color_modify: 'alpha', 0.10 }};
      }

      body {
        font-family: var(--font-body-family);
        font-weight: var(--font-body-weight);
        font-size: var(--font-base-size);
      }

      h1, h2, h3, h4, h5, .h1, .h2, .h3, .h4 {
        font-family: var(--font-heading-family);
        font-weight: var(--font-heading-weight);
        letter-spacing: var(--heading-letter-spacing);
      }

      .button--primary,
      .button--secondary {
        border-radius: var(--button-radius);
      }
    {% endstyle %}

    {{ 'theme.css' | asset_url | stylesheet_tag }}

    <script>document.documentElement.className = document.documentElement.className.replace('no-js', 'js');</script>
    <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>
  </head>

  <body class="template-{{ request.page_type | handle }}">
    <a class="skip-to-content" href="#MainContent">{{ 'accessibility.skip_to_text' | t }}</a>

    {% section 'announcement-bar' %}
    {% section 'header' %}

    <main id="MainContent" class="content-for-layout" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% section 'footer' %}

    {% render 'cart-drawer' %}

    <script>
      window.theme = window.theme || {};
      window.theme.routes = {
        cart_url: "{{ routes.cart_url }}",
        cart_add_url: "{{ routes.cart_add_url }}",
        cart_change_url: "{{ routes.cart_change_url }}",
        cart_update_url: "{{ routes.cart_update_url }}"
      };
      window.theme.strings = {
        addToCart: {{ 'products.product.add_to_cart' | t | json }},
        soldOut: {{ 'products.product.sold_out' | t | json }},
        adding: {{ 'products.product.adding' | t | json }}
      };
      window.theme.moneyFormat = {{ shop.money_format | json }};
    </script>
  </body>
</html>
