[
  {
    "name": "theme_info",
    "theme_name": "Verdura — Herbal Wellness",
    "theme_version": "1.0.0",
    "theme_author": "Verdura Studio",
    "theme_documentation_url": "https://shopify.dev/docs/themes",
    "theme_support_url": "https://shopify.dev/docs/themes"
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "header",
        "content": "Brand palette"
      },
      {
        "type": "color",
        "id": "color_primary",
        "label": "Primary / buttons",
        "default": "#5b7553",
        "info": "Used for buttons and key accents."
      },
      {
        "type": "color",
        "id": "color_button_text",
        "label": "Button text",
        "default": "#fbf9f3"
      },
      {
        "type": "color",
        "id": "color_secondary",
        "label": "Secondary",
        "default": "#3f4a39"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Accent (terracotta)",
        "default": "#c47a52"
      },
      {
        "type": "header",
        "content": "Backgrounds & text"
      },
      {
        "type": "color",
        "id": "color_background",
        "label": "Page background",
        "default": "#fbf8f1"
      },
      {
        "type": "color",
        "id": "color_background_alt",
        "label": "Alternate background",
        "default": "#f1ece0",
        "info": "Used to alternate section backgrounds."
      },
      {
        "type": "color",
        "id": "color_card_background",
        "label": "Card background",
        "default": "#ffffff"
      },
      {
        "type": "color",
        "id": "color_text",
        "label": "Text",
        "default": "#2c352a"
      },
      {
        "type": "header",
        "content": "Utility"
      },
      {
        "type": "color",
        "id": "color_sale",
        "label": "Sale price",
        "default": "#b04a3a"
      },
      {
        "type": "color",
        "id": "color_star",
        "label": "Review stars",
        "default": "#d9a441"
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "font_picker",
        "id": "heading_font",
        "label": "Heading font",
        "default": "playfair_display_n4"
      },
      {
        "type": "range",
        "id": "heading_scale",
        "min": 80,
        "max": 130,
        "step": 5,
        "unit": "%",
        "label": "Heading size scale",
        "default": 100
      },
      {
        "type": "range",
        "id": "heading_letter_spacing",
        "min": -2,
        "max": 2,
        "step": 1,
        "unit": "px",
        "label": "Heading letter spacing",
        "default": 0
      },
      {
        "type": "font_picker",
        "id": "body_font",
        "label": "Body font",
        "default": "assistant_n4"
      },
      {
        "type": "range",
        "id": "base_font_size",
        "min": 14,
        "max": 20,
        "step": 1,
        "unit": "px",
        "label": "Base font size",
        "default": 17
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "range",
        "id": "page_width",
        "min": 1100,
        "max": 1600,
        "step": 20,
        "unit": "px",
        "label": "Page width",
        "default": 1300
      },
      {
        "type": "range",
        "id": "section_spacing",
        "min": 40,
        "max": 120,
        "step": 4,
        "unit": "px",
        "label": "Spacing between sections",
        "default": 88
      },
      {
        "type": "range",
        "id": "corner_radius",
        "min": 0,
        "max": 36,
        "step": 2,
        "unit": "px",
        "label": "Corner radius",
        "default": 16
      },
      {
        "type": "range",
        "id": "button_radius",
        "min": 0,
        "max": 40,
        "step": 2,
        "unit": "px",
        "label": "Button corner radius",
        "default": 40
      }
    ]
  },
  {
    "name": "Product cards",
    "settings": [
      {
        "type": "checkbox",
        "id": "card_show_vendor",
        "label": "Show product vendor",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "card_show_rating",
        "label": "Show review stars",
        "default": true
      },
      {
        "type": "select",
        "id": "card_image_ratio",
        "label": "Image ratio",
        "options": [
          { "value": "square", "label": "Square" },
          { "value": "portrait", "label": "Portrait" },
          { "value": "landscape", "label": "Landscape" }
        ],
        "default": "square"
      }
    ]
  },
  {
    "name": "Cart",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "label": "Cart type",
        "options": [
          { "value": "drawer", "label": "Slide-out drawer" },
          { "value": "page", "label": "Cart page" }
        ],
        "default": "drawer"
      },
      {
        "type": "checkbox",
        "id": "cart_show_note",
        "label": "Enable order notes",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "cart_show_free_shipping_bar",
        "label": "Show free-shipping progress bar",
        "default": true
      },
      {
        "type": "range",
        "id": "cart_free_shipping_threshold",
        "min": 0,
        "max": 200,
        "step": 5,
        "unit": "$",
        "label": "Free shipping threshold",
        "default": 50
      }
    ]
  },
  {
    "name": "Social media",
    "settings": [
      {
        "type": "text",
        "id": "social_instagram",
        "label": "Instagram URL"
      },
      {
        "type": "text",
        "id": "social_facebook",
        "label": "Facebook URL"
      },
      {
        "type": "text",
        "id": "social_tiktok",
        "label": "TikTok URL"
      },
      {
        "type": "text",
        "id": "social_youtube",
        "label": "YouTube URL"
      },
      {
        "type": "text",
        "id": "social_pinterest",
        "label": "Pinterest URL"
      }
    ]
  },
  {
    "name": "Favicon",
    "settings": [
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon image",
        "info": "Will be scaled to 32 x 32px"
      }
    ]
  }
]
