<div class="collection-hero">
  <div class="page-width">
    <span class="eyebrow eyebrow--leaf">Journal</span>
    <h1>{{ blog.title }}</h1>
  </div>
</div>
<section class="section section--tight">
  <div class="page-width">
    {%- paginate blog.articles by 9 -%}
      <div class="grid blog-grid">
        {%- for article in blog.articles -%}
          <a href="{{ article.url }}" class="article-card reveal">
            <div class="article-card__media">
              {%- if article.image -%}
                <img src="{{ article.image | image_url: width: 700 }}" alt="{{ article.image.alt | escape | default: article.title }}" loading="lazy" width="700" height="438">
              {%- else -%}
                {{ 'blog-apparel-1' | placeholder_svg_tag: 'placeholder' }}
              {%- endif -%}
            </div>
            <h3>{{ article.title }}</h3>
            <div class="article-card__meta">{{ article.published_at | date: '%B %-d, %Y' }}{% if article.author %} · {{ 'blogs.article.by' | t }} {{ article.author }}{% endif %}</div>
            {%- if article.excerpt_or_content != blank -%}<p style="color:var(--color-foreground-soft);margin-top:.6rem">{{ article.excerpt_or_content | strip_html | truncate: 120 }}</p>{%- endif -%}
          </a>
        {%- endfor -%}
      </div>

      {%- if paginate.pages > 1 -%}
        <nav class="pagination" aria-label="Pagination">
          {%- for part in paginate.parts -%}
            {%- if part.is_link -%}<a href="{{ part.url }}">{{ part.title }}</a>
            {%- else -%}<span class="current">{{ part.title }}</span>{%- endif -%}
          {%- endfor -%}
        </nav>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{ "name": "Blog posts", "settings": [] }
{% endschema %}
