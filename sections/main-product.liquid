<section class="section section--tight">
  <div class="page-width">
    <div class="product">
      {%- comment -%} Gallery {%- endcomment -%}
      <div class="product__gallery" data-gallery>
        <div class="product__gallery-main" data-gallery-main>
          {%- if product.featured_media -%}
            <img src="{{ product.featured_media | image_url: width: 1000 }}" alt="{{ product.featured_media.alt | escape | default: product.title }}" width="1000" height="1000" fetchpriority="high">
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag: 'placeholder' }}
          {%- endif -%}
        </div>
        {%- if product.media.size > 1 -%}
          <div class="product__thumbs">
            {%- for media in product.media -%}
              <button type="button" data-gallery-thumb data-full="{{ media | image_url: width: 1000 }}">
                <img src="{{ media | image_url: width: 200 }}" alt="{{ media.alt | escape }}" loading="lazy" {% if forloop.first %}class="is-active"{% endif %}>
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} Buy box {%- endcomment -%}
      <div class="buybox">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'vendor' -%}
              {%- if product.vendor != blank -%}<span class="product-card__vendor" {{ block.shopify_attributes }}>{{ product.vendor }}</span>{%- endif -%}

            {%- when 'title' -%}
              <h1 class="product__title" {{ block.shopify_attributes }}>{{ product.title }}</h1>

            {%- when 'rating' -%}
              <div class="product__meta" {{ block.shopify_attributes }}>
                {% render 'stars', rating: block.settings.rating %}
                <span style="font-weight:600">{{ block.settings.rating_text }}</span>
              </div>

            {%- when 'price' -%}
              <div class="buybox__price" {{ block.shopify_attributes }}>
                <span class="price" data-price>{{ product.selected_or_first_available_variant.price | money }}</span>
                <span class="price--compare" data-compare-price {% unless product.selected_or_first_available_variant.compare_at_price > product.selected_or_first_available_variant.price %}hidden{% endunless %}>{{ product.selected_or_first_available_variant.compare_at_price | money }}</span>
                {%- if product.compare_at_price > product.price -%}<span class="badge-sale">{{ 'products.product.save' | t }} {{ product.compare_at_price | minus: product.price | money }}</span>{%- endif -%}
              </div>

            {%- when 'description' -%}
              <div class="product__description rte" {{ block.shopify_attributes }}>{{ product.description }}</div>

            {%- when 'features' -%}
              <ul class="buybox__feature-list" {{ block.shopify_attributes }}>
                {%- assign items = block.settings.features | newline_to_br | split: '<br />' -%}
                {%- for item in items -%}
                  {%- assign trimmed = item | strip -%}
                  {%- if trimmed != blank -%}<li>{% render 'icon', name: 'check-circle', width: 20, height: 20 %}<span>{{ trimmed }}</span></li>{%- endif -%}
                {%- endfor -%}
              </ul>

            {%- when 'buy_buttons' -%}
              {%- form 'product', product, data-product-form: 'main', class: 'buybox__form', id: 'product-form-main' -%}
                <script type="application/json" data-variant-json>
                  [
                    {%- for v in product.variants -%}
                      { "id": {{ v.id }}, "price": {{ v.price }}, "compare_at_price": {{ v.compare_at_price | default: 0 }}, "available": {{ v.available }}, "options": {{ v.options | json }} }{%- unless forloop.last -%},{%- endunless -%}
                    {%- endfor -%}
                  ]
                </script>

                {%- unless product.has_only_default_variant -%}
                  <div class="variant-options">
                    {%- for option in product.options_with_values -%}
                      <div class="variant-option" data-variant-option>
                        <span class="variant-option__label">{{ option.name }}</span>
                        <div class="variant-pills">
                          {%- for value in option.values -%}
                            <button type="button" class="variant-pill {% if option.selected_value == value %}is-selected{% endif %}" data-variant-pill data-value="{{ value | escape }}">{{ value }}</button>
                          {%- endfor -%}
                        </div>
                      </div>
                    {%- endfor -%}
                  </div>
                {%- endunless -%}

                <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">

                <div class="qty-row">
                  <div class="qty-selector" data-qty>
                    <button type="button" data-qty-change="-1" aria-label="Decrease">&minus;</button>
                    <input type="number" name="quantity" value="1" min="1" aria-label="{{ 'products.product.quantity' | t }}">
                    <button type="button" data-qty-change="1" aria-label="Increase">+</button>
                  </div>
                  <button type="submit" class="button--primary button--lg" data-atc style="flex:1" {% unless product.available %}disabled{% endunless %}>
                    <span data-atc-text>{% if product.available %}{{ 'products.product.add_to_cart' | t }}{% else %}{{ 'products.product.sold_out' | t }}{% endif %}</span>
                  </button>
                </div>

                {%- if block.settings.show_dynamic_checkout -%}{{ form | payment_button }}{%- endif -%}
              {%- endform -%}

            {%- when 'reassurance' -%}
              <div class="buybox__reassurance" {{ block.shopify_attributes }}>
                {%- if block.settings.item_1 != blank -%}<span>{% render 'icon', name: 'truck', width: 17, height: 17 %}{{ block.settings.item_1 }}</span>{%- endif -%}
                {%- if block.settings.item_2 != blank -%}<span>{% render 'icon', name: 'refresh', width: 17, height: 17 %}{{ block.settings.item_2 }}</span>{%- endif -%}
                {%- if block.settings.item_3 != blank -%}<span>{% render 'icon', name: 'shield', width: 17, height: 17 %}{{ block.settings.item_3 }}</span>{%- endif -%}
              </div>

            {%- when 'collapsible' -%}
              <div class="product__accordion" {{ block.shopify_attributes }}>
                <div class="faq__item" data-accordion-item>
                  <button class="faq__q" data-accordion-trigger aria-expanded="false">
                    <span>{{ block.settings.heading }}</span>{% render 'icon', name: 'plus', width: 20, height: 20 %}
                  </button>
                  <div class="faq__a" data-accordion-panel><div class="faq__a-inner rte">{{ block.settings.content }}</div></div>
                </div>
              </div>

            {%- when '@app' -%}
              {% render block %}
          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{%- comment -%} Sticky add-to-cart bar {%- endcomment -%}
{%- if section.settings.enable_sticky_atc and product.available -%}
  <div class="sticky-atc" data-sticky-atc>
    <div class="page-width sticky-atc__inner">
      <div class="sticky-atc__info">
        {%- if product.featured_media -%}<img src="{{ product.featured_media | image_url: width: 92 }}" alt="" class="sticky-atc__title">{%- endif -%}
        <div>
          <strong>{{ product.title | truncate: 38 }}</strong>
          <div class="price" style="font-weight:700">{{ product.price | money }}</div>
        </div>
      </div>
      <button type="submit" form="product-form-main" class="button--primary button--lg">{{ 'products.product.add_to_cart' | t }}</button>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Product page",
  "settings": [
    { "type": "checkbox", "id": "enable_sticky_atc", "label": "Enable sticky add-to-cart bar", "default": true }
  ],
  "blocks": [
    { "type": "vendor", "name": "Vendor", "limit": 1 },
    { "type": "title", "name": "Title", "limit": 1 },
    { "type": "rating", "name": "Rating", "limit": 1, "settings": [
      { "type": "range", "id": "rating", "min": 1, "max": 5, "step": 1, "label": "Stars", "default": 5 },
      { "type": "text", "id": "rating_text", "label": "Text", "default": "4.9 · 2,140 reviews" }
    ] },
    { "type": "price", "name": "Price", "limit": 1 },
    { "type": "features", "name": "Feature list", "settings": [
      { "type": "textarea", "id": "features", "label": "Features (one per line)", "default": "Whisper-quiet mist under 25 dB\nUp to 10 hours of continuous calm\nWarm amber mood light\nAuto shut-off for overnight safety" }
    ] },
    { "type": "buy_buttons", "name": "Buy buttons", "limit": 1, "settings": [
      { "type": "checkbox", "id": "show_dynamic_checkout", "label": "Show dynamic checkout button", "default": true }
    ] },
    { "type": "reassurance", "name": "Reassurance", "limit": 1, "settings": [
      { "type": "text", "id": "item_1", "label": "Item 1", "default": "Free shipping" },
      { "type": "text", "id": "item_2", "label": "Item 2", "default": "30-night returns" },
      { "type": "text", "id": "item_3", "label": "Item 3", "default": "2-year warranty" }
    ] },
    { "type": "description", "name": "Description", "limit": 1 },
    { "type": "collapsible", "name": "Collapsible row", "settings": [
      { "type": "text", "id": "heading", "label": "Heading", "default": "Shipping & returns" },
      { "type": "richtext", "id": "content", "label": "Content", "default": "<p>Free carbon-neutral shipping on every order. Try it for 30 nights — if it's not for you, return it for a full refund.</p>" }
    ] },
    { "type": "@app" }
  ],
  "default": {
    "blocks": [
      { "type": "title" },
      { "type": "rating" },
      { "type": "price" },
      { "type": "features" },
      { "type": "buy_buttons" },
      { "type": "reassurance" },
      { "type": "description" },
      { "type": "collapsible" }
    ]
  }
}
{% endschema %}
