<footer class="footer">
  <div class="page-width">
    <div class="footer__top">
      <div class="footer__brand">
        <div class="footer__brand-name">{{ section.settings.brand_name | default: shop.name }}</div>
        {%- if section.settings.tagline != blank -%}
          <p>{{ section.settings.tagline }}</p>
        {%- endif -%}
        <div class="footer__social">
          {%- if settings.social_instagram != blank -%}<a href="{{ settings.social_instagram }}" aria-label="Instagram" target="_blank" rel="noopener">{% render 'icon', name: 'instagram' %}</a>{%- endif -%}
          {%- if settings.social_facebook != blank -%}<a href="{{ settings.social_facebook }}" aria-label="Facebook" target="_blank" rel="noopener">{% render 'icon', name: 'facebook' %}</a>{%- endif -%}
          {%- if settings.social_tiktok != blank -%}<a href="{{ settings.social_tiktok }}" aria-label="TikTok" target="_blank" rel="noopener">{% render 'icon', name: 'tiktok' %}</a>{%- endif -%}
          {%- if settings.social_youtube != blank -%}<a href="{{ settings.social_youtube }}" aria-label="YouTube" target="_blank" rel="noopener">{% render 'icon', name: 'youtube' %}</a>{%- endif -%}
          {%- if settings.social_pinterest != blank -%}<a href="{{ settings.social_pinterest }}" aria-label="Pinterest" target="_blank" rel="noopener">{% render 'icon', name: 'pinterest' %}</a>{%- endif -%}
        </div>
      </div>

      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'menu' -%}
            {%- assign fmenu = linklists[block.settings.menu] -%}
            <div {{ block.shopify_attributes }}>
              <div class="footer__heading">{{ block.settings.heading | default: fmenu.title }}</div>
              <ul class="footer__links">
                {%- for link in fmenu.links -%}
                  <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                {%- endfor -%}
              </ul>
            </div>
          {%- when 'text' -%}
            <div {{ block.shopify_attributes }}>
              <div class="footer__heading">{{ block.settings.heading }}</div>
              <div class="footer__links rte">{{ block.settings.content }}</div>
            </div>
          {%- when 'newsletter' -%}
            <div {{ block.shopify_attributes }}>
              <div class="footer__heading">{{ block.settings.heading }}</div>
              <p style="color:#c8c0b0;font-size:.92rem;margin-bottom:1rem">{{ block.settings.text }}</p>
              {%- form 'customer', class: 'newsletter__form', style: 'max-width:none;margin:0' -%}
                <input type="hidden" name="contact[tags]" value="newsletter">
                <input type="email" name="contact[email]" placeholder="{{ 'general.newsletter_form.newsletter_email' | t }}" required aria-label="Email">
                <button type="submit" class="button--primary" aria-label="{{ 'general.newsletter_form.submit' | t }}">{% render 'icon', name: 'arrow-right' %}</button>
                {%- if form.posted_successfully? -%}<p class="form-success" style="flex-basis:100%">{{ 'general.newsletter_form.success' | t }}</p>{%- endif -%}
              {%- endform -%}
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>

    <div class="footer__bottom">
      <span>&copy; {{ 'now' | date: '%Y' }} {{ section.settings.brand_name | default: shop.name }}. {{ 'footer.copyright' | t }}.</span>
      {%- if section.settings.show_payment_icons -%}
        <div class="footer__payments">
          {%- for type in shop.enabled_payment_types -%}
            {{ type | payment_type_svg_tag: class: 'payment-icon' }}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand name",
      "default": "Verdura"
    },
    {
      "type": "textarea",
      "id": "tagline",
      "label": "Tagline",
      "default": "Bring the calm of a forest into every room. Pure botanical aromatherapy, thoughtfully made."
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show payment icons",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    },
    {
      "type": "text",
      "name": "Text column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "About" },
        { "type": "richtext", "id": "content", "label": "Content", "default": "<p>We craft pure, plant-based aromatherapy to help you slow down and breathe deeper.</p>" }
      ]
    },
    {
      "type": "newsletter",
      "name": "Newsletter",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Join the grove" },
        { "type": "text", "id": "text", "label": "Text", "default": "Sign up for calming rituals and 10% off your first order." }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "menu", "settings": { "heading": "Shop" } },
      { "type": "text", "settings": { "heading": "About" } },
      { "type": "newsletter" }
    ]
  }
}
{% endschema %}
