<section class="section section--tight">
  <div class="page-width page-width--narrow">
    <div class="text-center reveal" style="margin-bottom:2.5rem">
      <span class="eyebrow eyebrow--leaf">{{ section.settings.eyebrow | default: shop.name }}</span>
      <h1 class="text-balance">{{ page.title }}</h1>
    </div>
    <div class="rte reveal" style="margin-inline:auto">{{ page.content }}</div>
  </div>
</section>

{% schema %}
{
  "name": "Page",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Verdura" }
  ]
}
{% endschema %}
