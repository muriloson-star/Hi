{%- liquid
  assign product = all_products[section.settings.product]
-%}
<section class="section spotlight {% if section.settings.bg_style == 'alt' %}section--alt{% endif %}" id="product-spotlight">
  <div class="page-width">
    <div class="grid spotlight__grid">
      <div class="spotlight__media reveal" data-gallery>
        <div data-gallery-main>
          {%- if product != blank and product.featured_media != blank -%}
            <img src="{{ product.featured_media | image_url: width: 900 }}" alt="{{ product.title | escape }}" width="900" height="900">
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag: 'placeholder' }}
          {%- endif -%}
        </div>
        {%- if product != blank and product.media.size > 1 -%}
          <div class="spotlight__gallery">
            {%- for media in product.media limit: 4 -%}
              <button type="button" data-gallery-thumb data-full="{{ media | image_url: width: 900 }}" {% if forloop.first %}class="is-active"{% endif %}>
                <img src="{{ media | image_url: width: 200 }}" alt="{{ media.alt | escape }}" loading="lazy">
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <div class="buybox reveal">
        {%- if section.settings.eyebrow != blank -%}<span class="eyebrow eyebrow--leaf">{{ section.settings.eyebrow }}</span>{%- endif -%}
        <h2>{{ section.settings.heading | default: product.title | default: 'Featured product' }}</h2>

        {%- if section.settings.show_rating -%}
          <div style="margin-top:.7rem">{% render 'stars', rating: section.settings.rating %} <span style="font-weight:600;margin-left:.3rem">{{ section.settings.rating_text }}</span></div>
        {%- endif -%}

        {%- if product != blank -%}
          <div class="buybox__price">
            <span class="price" data-price>{{ product.selected_or_first_available_variant.price | money }}</span>
            <span class="price--compare" data-compare-price {% unless product.selected_or_first_available_variant.compare_at_price > product.selected_or_first_available_variant.price %}hidden{% endunless %}>{{ product.selected_or_first_available_variant.compare_at_price | money }}</span>
            {%- if product.compare_at_price > product.price -%}<span class="pill" style="color:var(--color-sale);background:color-mix(in srgb, var(--color-sale) 12%, transparent)">{{ 'products.product.save' | t }} {{ product.compare_at_price | minus: product.price | money }}</span>{%- endif -%}
          </div>
        {%- else -%}
          <div class="buybox__price"><span class="price">$59.00</span><span class="price--compare">$79.00</span></div>
        {%- endif -%}

        {%- if section.settings.description != blank -%}
          <p style="color:var(--color-foreground-soft)">{{ section.settings.description }}</p>
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <ul class="buybox__feature-list">
            {%- for block in section.blocks -%}
              {%- if block.type == 'feature' -%}
                <li {{ block.shopify_attributes }}>{% render 'icon', name: 'check-circle', width: 20, height: 20 %}<span>{{ block.settings.text }}</span></li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- if product != blank -%}
          {%- form 'product', product, data-product-form: 'spotlight', class: 'buybox__form' -%}
            <script type="application/json" data-variant-json>
              [
                {%- for v in product.variants -%}
                  { "id": {{ v.id }}, "price": {{ v.price }}, "compare_at_price": {{ v.compare_at_price | default: 0 }}, "available": {{ v.available }}, "options": {{ v.options | json }} }{%- unless forloop.last -%},{%- endunless -%}
                {%- endfor -%}
              ]
            </script>

            {%- unless product.has_only_default_variant -%}
              <div class="variant-options">
                {%- for option in product.options_with_values -%}
                  <div class="variant-option" data-variant-option>
                    <span class="variant-option__label">{{ option.name }}</span>
                    <div class="variant-pills">
                      {%- for value in option.values -%}
                        <button type="button" class="variant-pill {% if option.selected_value == value %}is-selected{% endif %}" data-variant-pill data-value="{{ value | escape }}">{{ value }}</button>
                      {%- endfor -%}
                    </div>
                  </div>
                {%- endfor -%}
              </div>
            {%- endunless -%}

            <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">

            <div class="qty-row">
              <div class="qty-selector" data-qty>
                <button type="button" data-qty-change="-1" aria-label="Decrease">&minus;</button>
                <input type="number" name="quantity" value="1" min="1" aria-label="{{ 'products.product.quantity' | t }}">
                <button type="button" data-qty-change="1" aria-label="Increase">+</button>
              </div>
              <button type="submit" class="button--primary button--lg" data-atc style="flex:1" {% unless product.available %}disabled{% endunless %}>
                <span data-atc-text>{% if product.available %}{{ 'products.product.add_to_cart' | t }}{% else %}{{ 'products.product.sold_out' | t }}{% endif %}</span>
                {%- if section.settings.show_price_in_button and product.available -%} · {{ product.price | money }}{%- endif -%}
              </button>
            </div>
          {%- endform -%}
        {%- else -%}
          <a href="#" class="button--primary button--lg button--full" style="margin-top:1.2rem">{{ 'products.product.add_to_cart' | t }}</a>
          <p style="font-size:.85rem;color:var(--color-foreground-soft);margin-top:1rem">Select a product in the theme editor to connect this buy box.</p>
        {%- endif -%}

        <div class="buybox__reassurance">
          {%- if section.settings.reassure_1 != blank -%}<span>{% render 'icon', name: 'truck', width: 17, height: 17 %}{{ section.settings.reassure_1 }}</span>{%- endif -%}
          {%- if section.settings.reassure_2 != blank -%}<span>{% render 'icon', name: 'refresh', width: 17, height: 17 %}{{ section.settings.reassure_2 }}</span>{%- endif -%}
          {%- if section.settings.reassure_3 != blank -%}<span>{% render 'icon', name: 'shield', width: 17, height: 17 %}{{ section.settings.reassure_3 }}</span>{%- endif -%}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product spotlight",
  "settings": [
    { "type": "select", "id": "bg_style", "label": "Background", "options": [ { "value": "default", "label": "Default" }, { "value": "alt", "label": "Alternate" } ], "default": "alt" },
    { "type": "product", "id": "product", "label": "Product" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Verdura Herbal Diffuser" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your daily ritual of calm" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Hand-finished ceramic, an ultra-fine plant-oil mist and a warm amber glow — designed to help your whole home exhale." },
    { "type": "checkbox", "id": "show_price_in_button", "label": "Show price in button", "default": false },
    { "type": "header", "content": "Rating" },
    { "type": "checkbox", "id": "show_rating", "label": "Show rating", "default": true },
    { "type": "range", "id": "rating", "min": 1, "max": 5, "step": 1, "label": "Stars", "default": 5 },
    { "type": "text", "id": "rating_text", "label": "Rating text", "default": "4.9 · 2,140 reviews" },
    { "type": "header", "content": "Reassurance row" },
    { "type": "text", "id": "reassure_1", "label": "Item 1", "default": "Free shipping" },
    { "type": "text", "id": "reassure_2", "label": "Item 2", "default": "30-night returns" },
    { "type": "text", "id": "reassure_3", "label": "Item 3", "default": "2-year warranty" }
  ],
  "blocks": [
    { "type": "feature", "name": "Feature", "settings": [ { "type": "text", "id": "text", "label": "Text", "default": "Whisper-quiet ultrasonic mist (under 25 dB)" } ] }
  ],
  "max_blocks": 6,
  "presets": [ { "name": "Product spotlight" } ],
  "default": {
    "blocks": [
      { "type": "feature", "settings": { "text": "Whisper-quiet mist — under 25 dB" } },
      { "type": "feature", "settings": { "text": "Up to 10 hours of continuous calm" } },
      { "type": "feature", "settings": { "text": "Warm amber mood light, 7 soft tones" } },
      { "type": "feature", "settings": { "text": "Auto shut-off when water runs low" } }
    ]
  }
}
{% endschema %}
