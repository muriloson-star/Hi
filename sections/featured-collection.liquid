{%- liquid
  assign collection = collections[section.settings.collection]
  assign limit = section.settings.products_to_show
-%}
<section class="section {% if section.settings.bg_style == 'alt' %}section--alt{% endif %}">
  <div class="page-width">
    <div class="text-center reveal">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow eyebrow--leaf">{{ section.settings.eyebrow }}</span>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="section-heading text-balance">{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.subheading != blank -%}<p class="section-subtext section-heading">{{ section.settings.subheading }}</p>{%- endif -%}
    </div>

    <div class="product-grid" style="margin-top:3rem">
      {%- if collection != blank and collection.products.size > 0 -%}
        {%- for product in collection.products limit: limit -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..4) -%}
          <div class="product-card reveal">
            <div class="product-card__media">{{ 'product-' | append: i | placeholder_svg_tag: 'placeholder' }}</div>
            <div class="product-card__info">
              <span class="product-card__title">Example product</span>
              <div class="product-card__price"><span class="price">$49.00</span></div>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>

    {%- if section.settings.button_text != blank and collection != blank -%}
      <div class="text-center reveal" style="margin-top:2.5rem">
        <a href="{{ collection.url }}" class="button--secondary button--lg">{{ section.settings.button_text }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    { "type": "select", "id": "bg_style", "label": "Background", "options": [ { "value": "default", "label": "Default" }, { "value": "alt", "label": "Alternate" } ], "default": "default" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Shop the collection" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Complete your ritual" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Pure essential oil blends, crafted to match every mood." },
    { "type": "range", "id": "products_to_show", "min": 2, "max": 12, "step": 1, "label": "Products to show", "default": 4 },
    { "type": "text", "id": "button_text", "label": "Button text", "default": "View all" }
  ],
  "presets": [ { "name": "Featured collection" } ]
}
{% endschema %}
