<section class="section {% if section.settings.bg_style == 'alt' %}section--alt{% elsif section.settings.bg_style == 'dark' %}section--dark{% endif %}">
  <div class="page-width page-width--narrow text-center reveal">
    {%- if section.settings.eyebrow != blank -%}<span class="eyebrow eyebrow--leaf">{{ section.settings.eyebrow }}</span>{%- endif -%}
    {%- if section.settings.heading != blank -%}<h2 class="text-balance">{{ section.settings.heading }}</h2>{%- endif -%}
    {%- if section.settings.text != blank -%}<div class="rte" style="margin:1.2rem auto 0;text-align:center">{{ section.settings.text }}</div>{%- endif -%}
    {%- if section.settings.button_text != blank -%}
      <div style="margin-top:1.8rem"><a href="{{ section.settings.button_link | default: '#' }}" class="button--primary button--lg">{{ section.settings.button_text }}</a></div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Rich text",
  "settings": [
    { "type": "select", "id": "bg_style", "label": "Background", "options": [ { "value": "default", "label": "Default" }, { "value": "alt", "label": "Alternate" }, { "value": "dark", "label": "Dark" } ], "default": "default" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our promise" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Slow living, bottled" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Verdura began with a simple idea: that the calm of a walk through the forest should be something you can bring home. Every product we make is a small invitation to slow down and breathe.</p>" },
    { "type": "text", "id": "button_text", "label": "Button" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [ { "name": "Rich text" } ]
}
{% endschema %}
