<section class="section {% if section.settings.bg_style == 'alt' %}section--alt{% endif %}">
  <div class="page-width page-width--narrow">
    <div class="text-center reveal">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow eyebrow--leaf">{{ section.settings.eyebrow }}</span>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="section-heading text-balance">{{ section.settings.heading }}</h2>{%- endif -%}
    </div>
    <div class="reveal" style="overflow-x:auto">
      <table class="compare-table">
        <thead>
          <tr>
            <th></th>
            <th class="col-us head">{{ section.settings.us_label }}</th>
            <th>{{ section.settings.them_label }}</th>
          </tr>
        </thead>
        <tbody>
          {%- for block in section.blocks -%}
            <tr {{ block.shopify_attributes }}>
              <td>{{ block.settings.feature }}</td>
              <td class="col-us">
                {%- if block.settings.us == 'yes' -%}<span class="yes">{% render 'icon', name: 'check', width: 20, height: 20 %}</span>
                {%- elsif block.settings.us == 'no' -%}<span class="no">—</span>
                {%- else -%}{{ block.settings.us_text }}{%- endif -%}
              </td>
              <td>
                {%- if block.settings.them == 'yes' -%}<span class="yes">{% render 'icon', name: 'check', width: 20, height: 20 %}</span>
                {%- elsif block.settings.them == 'no' -%}<span class="no">—</span>
                {%- else -%}{{ block.settings.them_text }}{%- endif -%}
              </td>
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Comparison table",
  "settings": [
    { "type": "select", "id": "bg_style", "label": "Background", "options": [ { "value": "default", "label": "Default" }, { "value": "alt", "label": "Alternate" } ], "default": "default" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The honest comparison" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Why people switch to Verdura" },
    { "type": "text", "id": "us_label", "label": "Your column label", "default": "Verdura" },
    { "type": "text", "id": "them_label", "label": "Their column label", "default": "Typical diffuser" }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Row",
      "settings": [
        { "type": "text", "id": "feature", "label": "Feature", "default": "Pure plant essential oils" },
        { "type": "select", "id": "us", "label": "Yours", "options": [ { "value": "yes", "label": "Yes (check)" }, { "value": "no", "label": "No (dash)" }, { "value": "text", "label": "Custom text" } ], "default": "yes" },
        { "type": "text", "id": "us_text", "label": "Yours — custom text" },
        { "type": "select", "id": "them", "label": "Theirs", "options": [ { "value": "yes", "label": "Yes (check)" }, { "value": "no", "label": "No (dash)" }, { "value": "text", "label": "Custom text" } ], "default": "no" },
        { "type": "text", "id": "them_text", "label": "Theirs — custom text" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [ { "name": "Comparison table" } ],
  "default": {
    "blocks": [
      { "type": "row", "settings": { "feature": "100% pure plant essential oils", "us": "yes", "them": "no" } },
      { "type": "row", "settings": { "feature": "Whisper-quiet under 25 dB", "us": "yes", "them": "no" } },
      { "type": "row", "settings": { "feature": "Runs up to 10 hours", "us": "text", "us_text": "10 hrs", "them": "text", "them_text": "3–4 hrs" } },
      { "type": "row", "settings": { "feature": "Hand-finished ceramic", "us": "yes", "them": "no" } },
      { "type": "row", "settings": { "feature": "2-year warranty", "us": "yes", "them": "no" } },
      { "type": "row", "settings": { "feature": "30-night home trial", "us": "yes", "them": "no" } }
    ]
  }
}
{% endschema %}
