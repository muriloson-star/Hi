{%- comment -%} Top announcement bar with rotating messages {%- endcomment -%}
{%- if section.blocks.size > 0 -%}
  <div class="announcement"{% if section.settings.bg != blank %} style="background:{{ section.settings.bg }};color:{{ section.settings.text_color }}"{% endif %}>
    <div class="page-width announcement__inner">
      {%- for block in section.blocks -%}
        <span class="announcement__item" {{ block.shopify_attributes }}{% unless forloop.first %} style="display:none"{% endunless %} data-announcement-slide>
          {%- if block.settings.icon != 'none' -%}{% render 'icon', name: block.settings.icon, width: 16, height: 16 %}{%- endif -%}
          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}">{{ block.settings.text }}</a>
          {%- else -%}
            {{ block.settings.text }}
          {%- endif -%}
        </span>
      {%- endfor -%}
    </div>
  </div>
  {%- if section.blocks.size > 1 -%}
    <script>
      (function () {
        var slides = document.querySelectorAll('[data-announcement-slide]');
        if (slides.length < 2) return;
        var i = 0;
        setInterval(function () {
          slides[i].style.display = 'none';
          i = (i + 1) % slides.length;
          slides[i].style.display = 'inline-flex';
        }, {{ section.settings.rotate_speed | times: 1000 }});
      })();
    </script>
  {%- endif -%}
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    {
      "type": "color",
      "id": "bg",
      "label": "Background",
      "default": "#3f4a39"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#f0ebe0"
    },
    {
      "type": "range",
      "id": "rotate_speed",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "Rotation speed",
      "default": 5
    }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Free carbon-neutral shipping on orders over $50"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (optional)"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "truck", "label": "Truck" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "sparkle", "label": "Sparkle" },
            { "value": "shield", "label": "Shield" },
            { "value": "heart", "label": "Heart" }
          ],
          "default": "leaf"
        }
      ]
    }
  ],
  "max_blocks": 5,
  "default": {
    "blocks": [
      { "type": "message", "settings": { "text": "Free carbon-neutral shipping over $50", "icon": "truck" } },
      { "type": "message", "settings": { "text": "100% pure plant-based essential oils", "icon": "leaf" } },
      { "type": "message", "settings": { "text": "30-night calm-sleep guarantee", "icon": "moon" } }
    ]
  }
}
{% endschema %}
