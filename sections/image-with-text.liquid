<section class="section {% if section.settings.bg_style == 'alt' %}section--alt{% endif %}">
  <div class="page-width">
    <div class="grid image-text__grid {% if section.settings.layout == 'reverse' %}image-text--reverse{% endif %}">
      <div class="image-text__media reveal">
        {%- if section.settings.image != blank -%}
          <img src="{{ section.settings.image | image_url: width: 900 }}" alt="{{ section.settings.image.alt | escape | default: section.settings.heading }}" width="900" height="800" loading="lazy">
        {%- else -%}
          {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder' }}
        {%- endif -%}
      </div>
      <div class="image-text__content reveal">
        {%- if section.settings.eyebrow != blank -%}<span class="eyebrow eyebrow--leaf">{{ section.settings.eyebrow }}</span>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2 class="text-balance">{{ section.settings.heading }}</h2>{%- endif -%}
        {%- if section.settings.text != blank -%}<div class="rte" style="margin-top:1rem;color:var(--color-foreground-soft)">{{ section.settings.text }}</div>{%- endif -%}

        {%- assign feature_blocks = section.blocks | where: 'type', 'feature' -%}
        {%- if feature_blocks.size > 0 -%}
          <ul>
            {%- for block in feature_blocks -%}
              <li {{ block.shopify_attributes }}>{% render 'icon', name: block.settings.icon, width: 22, height: 22 %}<span>{{ block.settings.text }}</span></li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- assign stat_blocks = section.blocks | where: 'type', 'stat' -%}
        {%- if stat_blocks.size > 0 -%}
          <div class="stat-row">
            {%- for block in stat_blocks -%}
              <div class="stat" {{ block.shopify_attributes }}>
                <strong>{{ block.settings.number }}</strong>
                <span>{{ block.settings.label }}</span>
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- if section.settings.button_text != blank -%}
          <div style="margin-top:2rem">
            <a href="{{ section.settings.button_link | default: '#' }}" class="button--primary button--lg">{{ section.settings.button_text }}</a>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Image with text",
  "settings": [
    { "type": "select", "id": "bg_style", "label": "Background", "options": [ { "value": "default", "label": "Default" }, { "value": "alt", "label": "Alternate" } ], "default": "default" },
    { "type": "select", "id": "layout", "label": "Image position", "options": [ { "value": "default", "label": "Left" }, { "value": "reverse", "label": "Right" } ], "default": "default" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Rooted in nature" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Pure botanicals, nothing to hide" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Every Verdura blend starts with steam-distilled essential oils from regenerative farms. No synthetic fragrance, no phthalates, no parabens — just plants, distilled and bottled with care.</p>" },
    { "type": "text", "id": "button_text", "label": "Button" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Checklist item",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "options": [ { "value": "check-circle", "label": "Check" }, { "value": "leaf", "label": "Leaf" }, { "value": "drop", "label": "Drop" }, { "value": "heart", "label": "Heart" }, { "value": "leaf-eco", "label": "Eco" } ], "default": "check-circle" },
        { "type": "text", "id": "text", "label": "Text", "default": "Steam-distilled, single-origin oils" }
      ]
    },
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        { "type": "text", "id": "number", "label": "Number", "default": "0%" },
        { "type": "text", "id": "label", "label": "Label", "default": "Synthetic fragrance" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [ { "name": "Image with text" } ],
  "default": {
    "blocks": [
      { "type": "feature", "settings": { "text": "Steam-distilled, single-origin oils", "icon": "drop" } },
      { "type": "feature", "settings": { "text": "Regeneratively farmed botanicals", "icon": "leaf-eco" } },
      { "type": "feature", "settings": { "text": "Cruelty-free & never tested on animals", "icon": "heart" } },
      { "type": "stat", "settings": { "number": "100%", "label": "Plant-derived" } },
      { "type": "stat", "settings": { "number": "0", "label": "Synthetics" } },
      { "type": "stat", "settings": { "number": "12k+", "label": "5-star reviews" } }
    ]
  }
}
{% endschema %}
