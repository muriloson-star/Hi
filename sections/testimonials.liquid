<section class="section {% if section.settings.bg_style == 'alt' %}section--alt{% endif %}">
  <div class="page-width">
    <div class="text-center reveal">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow eyebrow--leaf">{{ section.settings.eyebrow }}</span>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="section-heading text-balance">{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.show_summary -%}
        <div style="display:flex;gap:.6rem;align-items:center;justify-content:center;margin-top:1rem">
          {% render 'stars', rating: 5 %}
          <span style="font-weight:600">{{ section.settings.summary_text }}</span>
        </div>
      {%- endif -%}
    </div>
    <div class="grid testimonials__grid">
      {%- for block in section.blocks -%}
        <figure class="testimonial reveal" {{ block.shopify_attributes }}>
          {% render 'stars', rating: block.settings.rating %}
          <blockquote class="testimonial__quote">“{{ block.settings.quote }}”</blockquote>
          <figcaption class="testimonial__author">
            <span class="testimonial__avatar">
              {%- if block.settings.avatar != blank -%}
                <img src="{{ block.settings.avatar | image_url: width: 88 }}" alt="{{ block.settings.name | escape }}" width="44" height="44" loading="lazy">
              {%- else -%}
                {{ block.settings.name | slice: 0 }}
              {%- endif -%}
            </span>
            <span>
              <span class="testimonial__name">{{ block.settings.name }}</span>
              {%- if block.settings.verified -%}<span class="verified">{% render 'icon', name: 'check-circle', width: 14, height: 14 %} Verified buyer</span>
              {%- elsif block.settings.role != blank -%}<span class="testimonial__role">{{ block.settings.role }}</span>{%- endif -%}
            </span>
          </figcaption>
        </figure>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Testimonials",
  "settings": [
    { "type": "select", "id": "bg_style", "label": "Background", "options": [ { "value": "default", "label": "Default" }, { "value": "alt", "label": "Alternate" } ], "default": "alt" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Real reviews" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "12,000+ homes a little calmer" },
    { "type": "checkbox", "id": "show_summary", "label": "Show rating summary", "default": true },
    { "type": "text", "id": "summary_text", "label": "Summary text", "default": "4.9/5 from 2,140 verified reviews" }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        { "type": "range", "id": "rating", "min": 1, "max": 5, "step": 1, "label": "Stars", "default": 5 },
        { "type": "textarea", "id": "quote", "label": "Quote", "default": "I fall asleep so much faster now. The mist is silky and the lavender blend is heavenly." },
        { "type": "image_picker", "id": "avatar", "label": "Avatar" },
        { "type": "text", "id": "name", "label": "Name", "default": "Maya R." },
        { "type": "text", "id": "role", "label": "Role / location", "default": "Portland, OR" },
        { "type": "checkbox", "id": "verified", "label": "Verified buyer badge", "default": true }
      ]
    }
  ],
  "max_blocks": 9,
  "presets": [ { "name": "Testimonials" } ],
  "default": {
    "blocks": [
      { "type": "testimonial", "settings": { "quote": "I fall asleep so much faster now. The mist is silky and the lavender blend is heavenly.", "name": "Maya R.", "role": "Portland, OR" } },
      { "type": "testimonial", "settings": { "quote": "It looks gorgeous on my nightstand and it's whisper quiet. My whole bedroom feels like a spa.", "name": "Jordan T.", "role": "Austin, TX" } },
      { "type": "testimonial", "settings": { "quote": "Finally a diffuser with real essential oils, not fake fragrance. You can smell the difference.", "name": "Priya S.", "role": "Brooklyn, NY" } }
    ]
  }
}
{% endschema %}
