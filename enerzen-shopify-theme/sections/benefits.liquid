<section class="section benefits" id="benefits">
  <div class="container">
    {%- if section.settings.tag != blank or section.settings.heading != blank -%}
      <div class="section-header">
        {%- if section.settings.tag != blank -%}
          <div class="tag">{{ section.settings.tag | escape }}</div>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="section-title">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="section-subtitle">{{ section.settings.subheading | escape }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="benefits__grid" style="grid-template-columns: repeat({{ section.settings.columns }}, 1fr);">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'benefit' -%}
            <div class="benefit-card" {{ block.shopify_attributes }}>
              {%- if block.settings.icon != blank -%}
                <div class="benefit-icon">{{ block.settings.icon }}</div>
              {%- endif -%}
              {%- if block.settings.heading != blank -%}
                <h3>{{ block.settings.heading | escape }}</h3>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <p>{{ block.settings.text | escape }}</p>
              {%- endif -%}
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Benefits Grid",
  "settings": [
    {
      "type": "text",
      "id": "tag",
      "label": "Tag / Eyebrow",
      "default": "Why EnerZen"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Section Heading",
      "default": "<p>Why Wellness Lovers <em>Choose EnerZen</em></p>"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "From bedrooms to yoga studios — natural aromatherapy technology that actually works."
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Columns (Desktop)",
      "default": "3",
      "options": [
        { "value": "2", "label": "2 Columns" },
        { "value": "3", "label": "3 Columns" },
        { "value": "4", "label": "4 Columns" }
      ]
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit Card",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icon (emoji)",
          "default": "🌿"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Pure Aromatherapy"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "Ultrasonic technology preserves the full therapeutic benefit of essential oils."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Benefits Grid",
      "blocks": [
        { "type": "benefit", "settings": { "icon": "🌿", "heading": "Pure Aromatherapy", "text": "Ultrasonic technology preserves the full therapeutic benefit of essential oils — unlike heat diffusion, which breaks down their natural properties." } },
        { "type": "benefit", "settings": { "icon": "🌙", "heading": "Whisper-Quiet Operation", "text": "Runs under 28dB, quieter than a library, so it can mist all night without disturbing sleep or focus." } },
        { "type": "benefit", "settings": { "icon": "💧", "heading": "Smart Auto Shut-Off", "text": "A built-in sensor automatically powers down when water runs low — no need to babysit or worry about damage." } },
        { "type": "benefit", "settings": { "icon": "🎨", "heading": "7-Color Ambient Light", "text": "A soft, customizable LED glow creates a calming atmosphere in any room, day or night." } },
        { "type": "benefit", "settings": { "icon": "⏱️", "heading": "Flexible Timer Settings", "text": "Choose 1, 3, 6 hours, or continuous misting to match your routine." } },
        { "type": "benefit", "settings": { "icon": "🌎", "heading": "Eco-Friendly Materials", "text": "Crafted from sustainable, BPA-free materials with a natural wood-grain finish built to last for years." } }
      ]
    }
  ]
}
{% endschema %}
