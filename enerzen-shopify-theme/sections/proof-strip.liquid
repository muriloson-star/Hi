{%- if section.settings.show_section -%}
<div class="proof-strip">
  <div class="container">
    <div class="proof-strip__inner">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'item' -%}
            <div class="proof-item" {{ block.shopify_attributes }}>
              {%- if block.settings.icon != blank -%}
                <span class="icon">{{ block.settings.icon }}</span>
              {%- endif -%}
              {{ block.settings.label | escape }}
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "Proof Strip",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_section",
      "label": "Show Section",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Trust Item",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icon (emoji)",
          "default": "🚚"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Free Shipping $35+"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Proof Strip",
      "blocks": [
        { "type": "item", "settings": { "icon": "🚚", "label": "Free Shipping $35+" } },
        { "type": "item", "settings": { "icon": "🔒", "label": "Secure Checkout" } },
        { "type": "item", "settings": { "icon": "↩️", "label": "30-Day Returns" } },
        { "type": "item", "settings": { "icon": "⭐", "label": "4.9 / 5 Rating" } },
        { "type": "item", "settings": { "icon": "🌎", "label": "Sustainably Made" } }
      ]
    }
  ]
}
{% endschema %}
