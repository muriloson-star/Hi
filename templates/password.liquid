{% layout 'password' %}
<div style="min-height:100vh;display:grid;place-items:center;padding:2rem;background:var(--color-background);color:var(--color-foreground);font-family:var(--font-body-family)">
  <div style="max-width:520px;width:100%;text-align:center">
    <span class="eyebrow eyebrow--leaf" style="color:var(--color-primary)">Opening soon</span>
    <h1 style="font-family:var(--font-heading-family);font-size:clamp(2rem,5vw,3rem);line-height:1.1;margin-block:.6rem 1rem">{{ shop.name }}</h1>
    <p style="color:var(--color-foreground-soft);font-size:1.1rem;margin-bottom:2rem">
      {{ page_description | default: "We're planting something calming. Drop your email to be first through the door — and get 10% off launch day." }}
    </p>

    <div style="background:var(--color-card);border:1px solid var(--color-border);border-radius:var(--radius);padding:2rem">
      {%- form 'customer', class: 'newsletter__form', style: 'margin:0' -%}
        <input type="hidden" name="contact[tags]" value="prelaunch">
        <input type="email" name="contact[email]" placeholder="Email address" required aria-label="Email"
               style="flex:1;padding:.95em 1.2em;border-radius:var(--button-radius);border:1.5px solid var(--color-border);background:var(--color-background)">
        <button type="submit" class="button--primary">Notify me</button>
        {%- if form.posted_successfully? -%}<p class="form-success" style="flex-basis:100%">You're on the list 🌿</p>{%- endif -%}
      {%- endform -%}

      <hr style="border:none;border-top:1px solid var(--color-border);margin:1.8rem 0">

      <details>
        <summary style="cursor:pointer;font-weight:600;color:var(--color-primary)">Enter using password</summary>
        <div style="margin-top:1rem">
          {%- form 'storefront_password', class: 'newsletter__form', style: 'margin:0' -%}
            <input type="password" name="password" placeholder="Password" aria-label="Store password"
                   style="flex:1;padding:.95em 1.2em;border-radius:var(--button-radius);border:1.5px solid var(--color-border);background:var(--color-background)">
            <button type="submit" class="button--primary">Enter</button>
          {%- endform -%}
          {%- if form.errors -%}<p style="color:var(--color-sale);margin-top:.6rem">{{ form.errors.translated_fields.password | capitalize }} {{ form.errors.messages.password }}</p>{%- endif -%}
        </div>
      </details>
    </div>

    <p style="margin-top:2rem;font-size:.85rem;color:var(--color-foreground-soft)">&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}</p>
  </div>
</div>
