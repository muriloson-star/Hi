<section class="section section--tight">
  <div class="page-width page-width--narrow text-center">
    <span class="eyebrow eyebrow--leaf">{{ shop.name }}</span>
    <h1>Your gift card</h1>
    <p class="section-subtext" style="margin-inline:auto">A little calm, on us. Use this code at checkout.</p>

    <div style="background:var(--color-card);border:1px solid var(--color-border);border-radius:var(--radius);padding:2.5rem;margin-top:2rem">
      <div style="font-family:var(--font-heading-family);font-size:2.6rem;color:var(--color-primary)">{{ gift_card.balance | money }}</div>
      {%- if gift_card.expired -%}
        <p style="color:var(--color-sale);margin-top:.5rem">This gift card has expired.</p>
      {%- elsif gift_card.expires_on -%}
        <p style="color:var(--color-foreground-soft);margin-top:.5rem">Valid until {{ gift_card.expires_on | date: '%B %-d, %Y' }}</p>
      {%- endif -%}

      <div style="margin:1.6rem auto;display:inline-block;padding:1rem 1.4rem;border:2px dashed var(--color-border);border-radius:var(--radius);font-size:1.2rem;letter-spacing:.1em;font-weight:700">
        {{ gift_card.code | format_code }}
      </div>

      {%- assign identifier = gift_card.qr_identifier | default: gift_card.code -%}
      <div style="display:flex;justify-content:center;margin-top:1rem">
        <img src="https://api.qrserver.com/v1/create-qr-code/?size=160x160&data={{ identifier | url_encode }}" alt="Gift card QR code" width="160" height="160">
      </div>

      <a href="{{ shop.url }}" class="button--primary button--lg" style="margin-top:1.6rem">Start shopping</a>
    </div>
  </div>
</section>
