<section class="section section--tight">
  <div class="page-width page-width--narrow" style="max-width:460px">
    <div class="text-center" style="margin-bottom:2rem">
      <span class="eyebrow eyebrow--leaf">Almost there</span>
      <h1>Reset password</h1>
    </div>
    {%- form 'reset_customer_password' -%}
      {{ form.errors | default_errors }}
      <div class="field"><label for="pass">New password</label><input type="password" name="customer[password]" id="pass" required></div>
      <div class="field"><label for="passc">Confirm password</label><input type="password" name="customer[password_confirmation]" id="passc" required></div>
      <button type="submit" class="button--primary button--full button--lg">Reset password</button>
    {%- endform -%}
  </div>
</section>
