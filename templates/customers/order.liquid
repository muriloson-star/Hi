<section class="section section--tight">
  <div class="page-width">
    <span class="eyebrow eyebrow--leaf">Order {{ order.name }}</span>
    <h1 style="margin-bottom:.4rem">Order details</h1>
    <p style="color:var(--color-foreground-soft);margin-bottom:2rem">Placed {{ order.created_at | date: '%B %-d, %Y' }} · {{ order.financial_status_label }} · {{ order.fulfillment_status_label }}</p>

    <table class="compare-table" style="margin-top:0">
      <thead><tr><th>Item</th><th>Price</th><th>Qty</th><th>Total</th></tr></thead>
      <tbody>
        {%- for line in order.line_items -%}
          <tr>
            <td>{{ line.title }}</td>
            <td>{{ line.price | money }}</td>
            <td>{{ line.quantity }}</td>
            <td>{{ line.final_line_price | money }}</td>
          </tr>
        {%- endfor -%}
      </tbody>
      <tfoot>
        <tr><td colspan="3" style="text-align:right">Subtotal</td><td>{{ order.subtotal_price | money }}</td></tr>
        {%- for shipping in order.shipping_methods -%}
          <tr><td colspan="3" style="text-align:right">Shipping ({{ shipping.title }})</td><td>{{ shipping.price | money }}</td></tr>
        {%- endfor -%}
        {%- for tax in order.tax_lines -%}
          <tr><td colspan="3" style="text-align:right">Tax ({{ tax.title }})</td><td>{{ tax.price | money }}</td></tr>
        {%- endfor -%}
        <tr><td colspan="3" style="text-align:right"><strong>Total</strong></td><td><strong>{{ order.total_price | money }}</strong></td></tr>
      </tfoot>
    </table>

    <div class="grid" style="grid-template-columns:1fr 1fr;margin-top:2rem">
      <div><h3>Shipping address</h3><p style="color:var(--color-foreground-soft);margin-top:.6rem">{{ order.shipping_address | format_address }}</p></div>
      <div><h3>Billing address</h3><p style="color:var(--color-foreground-soft);margin-top:.6rem">{{ order.billing_address | format_address }}</p></div>
    </div>

    <p style="margin-top:2rem"><a href="{{ routes.account_url }}" class="link-arrow">Back to account</a></p>
  </div>
</section>
