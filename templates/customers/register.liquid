<section class="section section--tight">
  <div class="page-width page-width--narrow" style="max-width:460px">
    <div class="text-center" style="margin-bottom:2rem">
      <span class="eyebrow eyebrow--leaf">Join the grove</span>
      <h1>Create account</h1>
    </div>
    {%- form 'create_customer' -%}
      {{ form.errors | default_errors }}
      <div class="field"><label for="FirstName">First name</label><input type="text" name="customer[first_name]" id="FirstName"></div>
      <div class="field"><label for="LastName">Last name</label><input type="text" name="customer[last_name]" id="LastName"></div>
      <div class="field"><label for="Email">Email</label><input type="email" name="customer[email]" id="Email" required></div>
      <div class="field"><label for="Password">Password</label><input type="password" name="customer[password]" id="Password" required></div>
      <button type="submit" class="button--primary button--full button--lg">Create account</button>
    {%- endform -%}
    <p style="text-align:center;margin-top:1.5rem;color:var(--color-foreground-soft)">Already have an account? <a href="{{ routes.account_login_url }}" style="color:var(--color-primary);font-weight:600">Sign in</a></p>
  </div>
</section>
