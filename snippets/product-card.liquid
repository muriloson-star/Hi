{%- comment -%}
  Product card. Params: product (required).
  Uses theme settings for vendor / rating / image ratio.
{%- endcomment -%}
{%- liquid
  assign ratio_class = ''
  case settings.card_image_ratio
    when 'portrait'
      assign ratio_class = 'ratio-portrait'
    when 'landscape'
      assign ratio_class = 'ratio-landscape'
  endcase
  assign on_sale = false
  if product.compare_at_price > product.price
    assign on_sale = true
  endif
-%}
<div class="product-card reveal">
  <a href="{{ product.url }}" class="product-card__media {{ ratio_class }}">
    <div class="product-card__badges">
      {%- if on_sale -%}<span class="badge-sale">{{ 'products.product.on_sale' | t }}</span>{%- endif -%}
      {%- unless product.available -%}<span class="badge-sale" style="background:var(--color-secondary)">{{ 'products.product.sold_out' | t }}</span>{%- endunless -%}
    </div>
    {%- if product.featured_media -%}
      <img src="{{ product.featured_media | image_url: width: 600 }}"
           srcset="{{ product.featured_media | image_url: width: 300 }} 300w, {{ product.featured_media | image_url: width: 600 }} 600w"
           sizes="(max-width: 700px) 50vw, 300px"
           alt="{{ product.featured_media.alt | escape | default: product.title }}"
           width="600" height="600" loading="lazy">
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag: 'placeholder' }}
    {%- endif -%}
  </a>
  <div class="product-card__info">
    {%- if settings.card_show_vendor and product.vendor != blank -%}
      <span class="product-card__vendor">{{ product.vendor }}</span>
    {%- endif -%}
    <a href="{{ product.url }}" class="product-card__title">{{ product.title }}</a>
    {%- if settings.card_show_rating -%}
      {% render 'stars', rating: 5.0 %}
    {%- endif -%}
    <div class="product-card__price">
      {% render 'price', product: product %}
    </div>
  </div>
</div>
